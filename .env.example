# --- Obbligatorie in produzione ---
# Su Railway DATABASE_URL arriva dal plugin PostgreSQL (${{Postgres.DATABASE_URL}}).
DATABASE_URL=postgres://airline:airline@localhost:5432/airline

# --- Identità dell'istanza (decentralizzazione) ---
INSTANCE_NAME=La Mia Istanza
# URL pubblico (su Railway viene dedotto da RAILWAY_PUBLIC_DOMAIN se non impostato)
PUBLIC_URL=https://airline.example.com
# Token per bannare/aggiungere istanze dalla pagina "Rete istanze"
ADMIN_TOKEN=cambia-questo-token-lungo
# ID o URL di istanze da escludere, separati da virgola
BANNED_INSTANCES=
# Istanze extra oltre a servers.json, separate da virgola
FED_PEERS=
# URL del registro delle istanze (default: servers.json del repo GitHub). Vuoto = solo file locale
# FED_REGISTRY_URL=
# Solo per test locali tra istanze su localhost
# ALLOW_PRIVATE_PEERS=1
PORT=3000
